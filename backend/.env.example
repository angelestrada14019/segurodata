# ── Entorno ──────────────────────────────────────────────────────────────
ENV=development                      # development | test | production
AUTH_MODE=enabled                    # disabled SOLO permitido si ENV=development

# ── Supabase (proyecto segurodata — ref pluxaelenhkdaakxdrpm) ────────────
SUPABASE_URL=https://pluxaelenhkdaakxdrpm.supabase.co

# Clave de servicio — dos formatos equivalentes (usar uno):
#   Formato nuevo (preferido): sb_secret_<...>  → Dashboard → Settings → API → Secret key
#   Formato legacy JWT:        eyJhbGci<...>    → Dashboard → Settings → API → service_role
# Ambos válidos hasta fin 2026. NUNCA exponer al frontend.
SUPABASE_SERVICE_KEY=

# JWT: si el proyecto usa llaves asimétricas (ES256/RS256) dejar JWT_SECRET vacío
# y poner la URL JWKS. Si usa HS256 legacy, poner el JWT Secret y dejar JWKS_URL vacío.
SUPABASE_JWT_SECRET=                 # Dashboard → Settings → API → JWT Secret (solo si HS256)
SUPABASE_JWKS_URL=                   # <SUPABASE_URL>/auth/v1/.well-known/jwks.json (si ES256)

SUPABASE_DB_URL=                     # solo scripts offline (seed COPY) — Settings → Database → Session pooler

# ── OpenRouter (proxy LLM — Módulos 3 y 4) ───────────────────────────────
OPENROUTER_API_KEY=
LLM_MODEL=google/gemini-flash-1.5
LLM_MODEL_FALLBACK=anthropic/claude-haiku

# ── Embeddings (384 dims, NUNCA cambiar de modelo sin reindexar corpus) ──
EMBEDDINGS_BACKEND=sentence-transformers   # fastembed en dev local (más liviano)

# ── CORS (prod: dominio Vercel exacto, sin *) ────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── Opcional ─────────────────────────────────────────────────────────────
TABLA_ONTOLOGICA_PATH=               # override del JSON bundleado (Notebook 03)
