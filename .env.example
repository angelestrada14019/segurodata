# SeguroData Bogota — Variables de entorno
# Copiar este archivo como .env y completar los valores reales
# El archivo .env NUNCA se sube al repositorio

# Token Socrata (opcional pero recomendado para mayor cuota en F6)
# Registro gratuito en: https://dev.socrata.com/register
SOCRATA_APP_TOKEN=tu_token_aqui

# Claude API — necesario para Modulos 3 (Recomendacion) y 4 (Chatbot)
# Obtener en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-tu_key_aqui
