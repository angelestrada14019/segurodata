# ── Datos descargados ─────────────────────────────────────────────────────────
# Se regeneran ejecutando: python src/pipeline.py
datos/raw/*
datos/procesados/*
datos/features/*
datos/modelos/*
graficas/*

# Preservar estructura de carpetas sin subir los datos
!datos/raw/.gitkeep
!datos/procesados/.gitkeep
!datos/features/.gitkeep
!datos/modelos/.gitkeep
!graficas/.gitkeep

# metricas.json SI se versiona (a diferencia del resto de datos/modelos/*) --
# historial real de performance del modelo en el tiempo, defendible ante el
# jurado. Se sobreescribe y commitea en cada entrenamiento.
!datos/modelos/metricas.json

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/

# ── Variables de entorno ──────────────────────────────────────────────────────
.env
*.env
# .env.example SI se sube (es el template sin valores reales)

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Modelos entrenados ────────────────────────────────────────────────────────
# Solo el modelo final de produccion va al repo
*.pkl
*.joblib
*.h5

# ── Claude Code — solo settings locales ──────────────────────────────────────
# .claude/commands/ y .claude/skills/ SI se suben (slash commands del equipo)
.claude/settings.local.json

# ── Archivos no pertenecientes al proyecto ────────────────────────────────────
guia_bogota_profunda.html
skills-lock.json

# ── IDEs ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Artefactos temporales de herramientas ────────────────────────────────────
.playwright-mcp/

# ── Materiales privados de sustentación ──────────────────────────────────────
# Guion de video, demo script y slides — contienen notas de presentación y
# respuestas ensayadas al jurado, no son documentación pública del proyecto.
docs/sustentacion/
